{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "default_agent": "ontology-direct-context",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "permission": {
    "*": "deny"
  },
  "agent": {
    "ontology-direct-context": {
      "description": "Plan data queries from an ontology embedded directly in the prompt",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:./prompt.md}",
      "temperature": 0,
      "permission": {
        "*": "deny"
      }
    }
  }
}
