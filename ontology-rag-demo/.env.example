# Qwen/OpenAI-compatible API. Keep real values only in the ignored .env file
# or inject them through the process environment.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=
QWEN_TIMEOUT_SECONDS=120

# Agent Skill endpoint. This local URL is non-sensitive; production/internal
# addresses should stay in the ignored .env or deployment environment.
OAG_BASE_URL=http://127.0.0.1:8010

# Committed synthetic sample. Override only in the ignored .env when testing
# a real ontology or private source documents.
SOURCE_ONTOLOGY_PATH=examples/smart-building/ontology.ttl
SOURCE_DOCUMENT_PATHS=examples/smart-building/documents/operations-guide.txt

# Runtime data paths, relative to this project directory.
ONTOLOGY_PATH=data/source/smart-building/ontology.ttl
DOCUMENTS_DIR=data/source/smart-building/documents
LANCEDB_URI=state/smart-building/lancedb
LANCEDB_TABLE=ontology_chunks_v1

# The deterministic backend makes a fresh clone runnable without model weights.
# Switch to bge-m3 for retrieval-quality evaluation.
EMBEDDING_BACKEND=deterministic
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=2
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=true

VECTOR_TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
GRAPH_MAX_ANCHORS=6
GRAPH_MAX_NODES=80

API_HOST=127.0.0.1
API_PORT=8010
LOG_LEVEL=INFO
TOKENIZERS_PARALLELISM=false
