# This file only contains optional source-time settings. Runtime paths, Dataset
# paths, OpenCode DB paths and Agent model IDs are derived by the Runtime manager.
# EMBEDDING_MODEL below is the retrieval embedding model, not the Agent model.
#
# The deterministic backend makes a fresh clone runnable without model weights.
# Set bge-m3 before creating an ontology-retrieval Runtime for quality tests.
EMBEDDING_BACKEND=deterministic
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=2
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=true

# Optional Hugging Face behavior. Do not put access tokens in this example.
HF_HUB_DISABLE_XET=1
TOKENIZERS_PARALLELISM=false
