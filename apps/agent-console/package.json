{
  "name": "ontology-agent-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n bridge,ui -c cyan,magenta \"pnpm dev:bridge\" \"pnpm dev:ui\"",
    "dev:bridge": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server-typecheck.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server-typecheck.json",
    "test": "vitest run",
    "probe:acp": "tsx server/probe-cli.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.13.1",
    "ajv": "8.20.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "dompurify": "3.4.12",
    "marked": "17.0.1",
    "pinia": "3.0.4",
    "vue": "3.5.27",
    "ws": "8.21.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "25.1.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "concurrently": "9.2.1",
    "jsdom": "27.0.1",
    "tsx": "4.21.0",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12"
  }
}
